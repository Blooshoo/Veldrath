<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Repository-level NuGet configuration.

    Why this file exists:
    On Windows machines (and container images) that have Visual Studio installed,
    a machine-wide NuGet config — for example
    "%ProgramFiles(x86)%\NuGet\Config\Microsoft.VisualStudio.FallbackLocation.config" —
    injects a Windows-only fallback package folder:
        C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages

    Because this repository previously had no NuGet.config, every restore inherited
    that fallback folder and recorded it into the generated restore outputs
    (obj/<project>.csproj.nuget.g.props, obj/project.assets.json and
    obj/<project>.csproj.nuget.dgspec.json). When those stale Windows-generated
    artifacts are later consumed by a Linux build — for example inside the Docker
    dev container, where docker-compose.dev.yml bind-mounts the source tree (bind
    mounts bypass .dockerignore) and Dockerfile.dev runs "dotnet watch" — MSBuild's
    ResolvePackageAssets task fails with:

        error MSB4018: NuGet.Packaging.Core.PackagingException:
        Unable to find fallback package folder
        'C:\Program Files (x86)\Microsoft Visual Studio\Shared\NuGetPackages'.

    Clearing fallbackPackageFolders here stops the Windows-only folder from ever
    being inherited or recorded, so restore output is portable across Windows and
    Linux. Do not remove this <clear /> element.
  -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
