# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Public URLs (Tailscale / remote access) ───────────────────────────────
# When accessing the dev stack from another machine via Tailscale, override
# the default localhost URLs so OAuth redirects and browser navigation work.
# Example for a Tailscale machine named "kung-gaming" at IP 100.115.128.32:
#   SERVER_PUBLIC_URL=http://kung-gaming.tail3ff356.ts.net:9000
#   WEB_PUBLIC_URL=http://kung-gaming.tail3ff356.ts.net:8080
# Leave commented out for local-only development (defaults to localhost).
# SERVER_PUBLIC_URL=http://localhost:9000
# WEB_PUBLIC_URL=http://localhost:8080

# ── Allowed OAuth return URL hostnames ────────────────────────────────────
# Comma-separated list of hostnames/IPs the server accepts as valid OAuth
# return URLs, in addition to localhost and Web:BaseUrl.
# Set this when accessing the stack via multiple hostnames/IPs:
#   ALLOWED_RETURN_URL_HOSTS=kung-gaming.tail3ff356.ts.net,100.115.128.32
# Leave empty to accept only localhost and the configured Foundry/Web URLs.
# ALLOWED_RETURN_URL_HOSTS=

# ── HTTPS dev certificate ──────────────────────────────────────────────────
# Export your dev cert once with:
#   dotnet dev-certs https -ep "$env:USERPROFILE\.aspnet\https\veldrath.pfx" -p "your_password_here"
#   dotnet dev-certs https --trust
CERT_PASSWORD=your_password_here

# ── JWT signing key (docker / production) ─────────────────────────────────
# Must be at least 32 characters. Keep this secret.
# Shared by Veldrath.Server and the SvelteKit auth token minting.
# For local dev outside Docker, set via: dotnet user-secrets set "Jwt:Key" "..."
JWT_KEY=your_jwt_signing_key_at_least_32_chars_here

# Shared secret for the temporary SvelteKit → .NET account bridge used while
# Blazor Foundry still authenticates through the .NET Identity endpoints.
# Generate with: openssl rand -base64 32
INTERNAL_BRIDGE_TOKEN=change-me_shared_internal_bridge_token

# ── SvelteKit / Better Auth ────────────────────────────────────────────────
# Dedicated Postgres role for Better Auth tables. The first-boot init script
# creates this role and the auth schema in the Postgres container.
AUTH_DB_USER=veldrath_auth
AUTH_DB_PASSWORD=veldrath_auth_dev
# Better Auth session secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_at_least_32_chars

# ── Discord bot (Veldrath.Discord service) ─────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token
DISCORD_DEV_GUILD_ID=123456789

# ── OAuth provider credentials (Veldrath.Server) ────────────────────────────
# Veldrath.Server loads the repo-root .env automatically when running in
# Development (`dotnet run`), mapping these to OAuth:* configuration keys.
# Docker Compose injects the values directly; production uses real env vars.
# Alternatively set them via dotnet user-secrets (see below).
#
# dotnet user-secrets --project Veldrath.Server set "OAuth:Discord:ClientId"     "..."
# dotnet user-secrets --project Veldrath.Server set "OAuth:Discord:ClientSecret" "..."
# dotnet user-secrets --project Veldrath.Server set "OAuth:Google:ClientId"      "..."
# dotnet user-secrets --project Veldrath.Server set "OAuth:Google:ClientSecret"  "..."
# dotnet user-secrets --project Veldrath.Server set "OAuth:Microsoft:ClientId"     "..."
# dotnet user-secrets --project Veldrath.Server set "OAuth:Microsoft:ClientSecret" "..."

# Discord — https://discord.com/developers/applications → OAuth2
# Redirect URI: http://localhost:5173/api/auth/callback/discord
# Production:   https://veldrath.com/api/auth/callback/discord
OAUTH_DISCORD_CLIENT_ID=your_discord_oauth_client_id
OAUTH_DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret

# Google — https://console.cloud.google.com → APIs & Services → Credentials
# Redirect URI: http://localhost:5173/api/auth/callback/google
# Production:   https://veldrath.com/api/auth/callback/google
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Microsoft — https://portal.azure.com → App registrations
# Redirect URI: http://localhost:5173/api/auth/callback/microsoft
# Production:   https://veldrath.com/api/auth/callback/microsoft
OAUTH_MICROSOFT_CLIENT_ID=your_microsoft_client_id
OAUTH_MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
# Optional for single-tenant Microsoft apps; leave empty for consumers/common.
OAUTH_MICROSOFT_TENANT_ID=

# ── Seq (structured log viewer) ────────────────────────────────────────────
# Password for the Seq admin account (user: admin).
# Web UI is available at http://localhost:9001 when running docker compose.
SEQ_ADMIN_PASSWORD=seq_dev_admin

# ── Grafana (metrics dashboard) ────────────────────────────────────────────
# Password for the Grafana admin account (user: admin).
# Dashboard is available at http://localhost:9002 when running docker compose.
GF_ADMIN_PASSWORD=grafana_dev_admin

# ── Production SMTP override ───────────────────────────────────────────────
# To route outbound email through a real relay, set these in your production
# .env and deploy with the prod overlay:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# EMAIL_SMTP_HOST=smtp.yourprovider.com
# EMAIL_SMTP_PORT=587
# EMAIL_ENABLE_TLS=true
# EMAIL_USER=your_smtp_username
# EMAIL_PASSWORD=your_smtp_password
# EMAIL_SENDER_ADDRESS=noreply@veldrath.com

# ── Production deployment ─────────────────────────────────────────────────
# Coolify uses docker-compose.coolify.yml with Traefik. The prod overlay is
# for a self-hosted Compose stack behind an external reverse proxy.

# Public HTTPS URL of the game server API — used by Foundry for OAuth redirects.
# Must match the DNS A record pointing to your VPS.
FOUNDRY_PUBLIC_SERVER_URL=https://api.veldrath.com