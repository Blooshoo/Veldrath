# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
#
# This file drives the local Docker stack (docker-compose.yml / .dev.yml) and
# `dotnet run` in Development (Veldrath.Server/Infrastructure/DotEnvConfiguration.cs
# maps the names below onto ASP.NET configuration keys).
#
# Coolify ignores this file: each resource gets its own environment variables.
# See docs/coolify-deployment.md for the per-resource lists and the variables that
# must be identical on the server and web resources.
#
# The SvelteKit app has its own local file: web/client/.env (see
# web/client/.env.example). The overlap between the two is listed under
# "Shared with the SvelteKit web app" below.

# ── Public URLs (docker compose / Tailscale) ───────────────────────────────
# WEB_PUBLIC_URL is the site origin: compose derives the server's Web__BaseUrl
# and the web container's ORIGIN and BETTER_AUTH_URL from it.
# SERVER_PUBLIC_URL is the browser-reachable API origin: compose derives the
# web container's PUBLIC_API_URL and PUBLIC_HUB_URL from it (and uses it as the
# default SignalR hub prefix).
# Example for a Tailscale machine named "kung-gaming" at IP 100.115.128.32:
#   SERVER_PUBLIC_URL=http://kung-gaming.tail3ff356.ts.net:9000
#   WEB_PUBLIC_URL=http://kung-gaming.tail3ff356.ts.net:8081
# Leave commented out for local-only development (defaults to localhost).
# SERVER_PUBLIC_URL=http://localhost:9000
# WEB_PUBLIC_URL=http://localhost:8081

# ── Allowed OAuth return URL hostnames ────────────────────────────────────
# Comma-separated list of hostnames/IPs the server accepts as valid OAuth
# return URLs, in addition to localhost and the configured web/Foundry origin.
# Set this when accessing the stack via multiple hostnames/IPs:
#   ALLOWED_RETURN_URL_HOSTS=kung-gaming.tail3ff356.ts.net,100.115.128.32
# Leave empty to accept only localhost and the configured URLs.
# ALLOWED_RETURN_URL_HOSTS=

# ── Shared with the SvelteKit web app ─────────────────────────────────────
# These must be byte-identical on both the Veldrath.Server and web resources.
# In Coolify they are therefore duplicated onto both resources.

# JWT signing key (HMAC-SHA, at least 32 characters). The web mints game tokens
# with it, the server validates them. A mismatch returns 401 from /api/characters.
# Generate with: openssl rand -base64 48
JWT_KEY=your_jwt_signing_key_at_least_32_chars_here

# Shared secret for the SvelteKit → .NET account bridge (desktop sign-in and
# transactional email). Sent as the X-Internal-Bridge-Token header; unset on the
# server disables the bridge endpoints (503).
# Generate with: openssl rand -base64 32
INTERNAL_BRIDGE_TOKEN=change-me_shared_internal_bridge_token

# OAuth provider credentials — the same apps are used by Veldrath.Server and by
# Better Auth on the web side (the web app registers
# https://<web-origin>/api/auth/callback/{provider} as an extra redirect URI).
# Discord — https://discord.com/developers/applications → OAuth2
OAUTH_DISCORD_CLIENT_ID=your_discord_oauth_client_id
OAUTH_DISCORD_CLIENT_SECRET=your_discord_oauth_client_secret
# Google — https://console.cloud.google.com → APIs & Services → Credentials
OAUTH_GOOGLE_CLIENT_ID=your_google_client_id
OAUTH_GOOGLE_CLIENT_SECRET=your_google_client_secret
# Microsoft — https://portal.azure.com → App registrations
OAUTH_MICROSOFT_CLIENT_ID=your_microsoft_client_id
OAUTH_MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
# Optional single-tenant Microsoft apps; leave empty for consumers/common.
# Only the web app (Better Auth) reads this — the .NET server does not.
OAUTH_MICROSOFT_TENANT_ID=

# ── SvelteKit / Better Auth (web container only) ───────────────────────────
# Dedicated Postgres role for the Better Auth tables. The first-boot init script
# creates the role and the `auth` schema; compose builds the web container's
# DATABASE_URL from these two values.
AUTH_DB_USER=veldrath_auth
AUTH_DB_PASSWORD=veldrath_auth_dev
# Better Auth session secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_at_least_32_chars

# ── Veldrath.Server only ───────────────────────────────────────────────────
# dotnet user-secrets equivalents:
#   dotnet user-secrets --project Veldrath.Server set "Jwt:Key" "..."
#   dotnet user-secrets --project Veldrath.Server set "OAuth:Discord:ClientId" "..."
#
# Seq log shipping target (compose sets http://seq automatically).
# SEQ_SERVER_URL=http://localhost:5341
#
# Web origin used for OAuth return URLs and the default CORS origin. In compose
# this is derived from WEB_PUBLIC_URL above; set it directly when running the
# server without compose.
# WEB_PUBLIC_URL=https://veldrath.com
#
# Foundry is served by the web app now, so this is usually the same as the web
# origin. Leave unset to fall back to Web__BaseUrl.
# FOUNDRY_PUBLIC_URL=https://veldrath.com

# ── Discord bot (Veldrath.Discord service) ─────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token
DISCORD_DEV_GUILD_ID=123456789

# ── Seq (structured log viewer) ────────────────────────────────────────────
# Password for the Seq admin account (user: admin).
# Web UI is available at http://localhost:9001 when running docker compose.
SEQ_ADMIN_PASSWORD=seq_dev_admin

# ── Grafana (metrics dashboard) ────────────────────────────────────────────
# Password for the Grafana admin account (user: admin).
# Dashboard is available at http://localhost:9002 when running docker compose.
GF_ADMIN_PASSWORD=grafana_dev_admin

# ── Production SMTP override ───────────────────────────────────────────────
# To route outbound email through a real relay, set these in your production
# .env and deploy with the prod overlay:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# EMAIL_SMTP_HOST=smtp.yourprovider.com
# EMAIL_SMTP_PORT=587
# EMAIL_ENABLE_TLS=true
# EMAIL_USER=your_smtp_username
# EMAIL_PASSWORD=your_smtp_password
# EMAIL_SENDER_ADDRESS=noreply@veldrath.com

# ── Production Postgres (prod overlay only) ────────────────────────────────
# docker-compose.prod.yml builds the server connection string from these and
# adds `SSL Mode=Require`. Coolify users get the equivalent values from the
# managed Postgres service instead.
# POSTGRES_HOST=db.example.com
# POSTGRES_PORT=5432
# POSTGRES_DB=veldrath
# POSTGRES_USER=veldrath
# POSTGRES_PASSWORD=your_postgres_password

# ── Account migration (one-off) ────────────────────────────────────────────
# Owner/admin connection used by web/scripts/migrate-identity-accounts.mjs when
# DATABASE_URL points at the restricted veldrath_auth role.
# MIGRATION_DATABASE_URL=postgres://veldrath:password@localhost:5433/veldrath
