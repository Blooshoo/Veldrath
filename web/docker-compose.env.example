# docker-compose.env.example
#
# Copy this file to `.env` next to the local compose file and adjust.
# On Coolify, set these in the application Environment Variables UI instead.

# --- PostgreSQL ---
POSTGRES_USER=veldrath
POSTGRES_PASSWORD=veldrath_dev # SECRET — override
POSTGRES_DB=veldrath

# --- Database connection (SvelteKit auth tables only) ---
# Use a role whose search_path points at the auth schema.
# DATABASE_URL=postgres://veldrath:veldrath_dev@postgres:5432/veldrath

# --- SvelteKit / Better Auth ---
ORIGIN=http://localhost:8080
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me # SECRET — override
BETTER_AUTH_URL=http://localhost:8080

# --- Game JWT — must match Veldrath.Server ---
JWT_KEY=dev-secret-key-change-in-production-must-be-32-chars # SECRET — override
JWT_ISSUER=Veldrath.Server
JWT_AUDIENCE=Veldrath.Client

# --- Public browser endpoints ---
PUBLIC_API_URL=http://localhost:9000
PUBLIC_HUB_URL=http://localhost:9000/hubs/game

# --- Host port mapping ---
CLIENT_PORT=8080
