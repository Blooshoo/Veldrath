# @veldrath/web — SvelteKit app with Better Auth.
#
# DATABASE_URL is used by the SvelteKit server for Better Auth tables only.
# Connect as the dedicated auth role, never as the shared `veldrath` owner.
# The role's search_path must be `auth` (see shared/db/README.md).
#
# The repository root docker-compose maps Postgres to localhost:5433.
# The web-only compose file in this directory maps it to localhost:5432.
DATABASE_URL="postgres://veldrath_auth:veldrath_auth_dev@localhost:5433/veldrath"

# Public origin of the SvelteKit app. adapter-node requires ORIGIN at runtime.
ORIGIN="http://localhost:5173"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# Game JWT — MUST match the key the .NET server actually loads.
# In local development the root .env JWT_KEY overrides appsettings, so copy
# that value here. The fallback below matches appsettings.Development.json.
# SvelteKit mints short-lived game tokens with this key.
JWT_KEY="dev-secret-key-change-in-production-must-be-32-chars"
JWT_ISSUER="Veldrath.Server"
JWT_AUDIENCE="Veldrath.Client"

# Public endpoints used by the browser.
PUBLIC_API_URL="http://localhost:9000"

# Server-side only bridge to ASP.NET Identity for the Blazor Foundry transition.
# In Docker use http://server:8080; outside Docker use the local server URL.
INTERNAL_BRIDGE_URL="http://localhost:9000"
# Must match InternalBridge__Token on Veldrath.Server (root .env INTERNAL_BRIDGE_TOKEN).
INTERNAL_BRIDGE_TOKEN="change-me_shared_internal_bridge_token"
PUBLIC_HUB_URL="http://localhost:9000/hubs/game"

# OAuth providers — leave blank to disable a provider.
# Register these callback URLs with each provider:
#   http://localhost:5173/api/auth/callback/discord
#   http://localhost:5173/api/auth/callback/google
#   http://localhost:5173/api/auth/callback/microsoft
# Production uses https://veldrath.com/api/auth/callback/{provider}.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
