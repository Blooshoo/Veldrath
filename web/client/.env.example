# @veldrath/web — SvelteKit app with Better Auth.
#
# Copy to web/client/.env for `npm run dev`, `npm run build`, `npm run test` and
# `npm run preview`. The Docker image does NOT bake this file in; the container
# reads the same variables from its environment (see web/client/Dockerfile and
# docs/coolify-deployment.md).
#
# SvelteKit 3 rules that affect this file:
#   - PUBLIC_* values are declared in src/env.ts, inlined into the browser bundle
#     at build time AND validated from process.env at server startup.
#   - Everything else is server-only and read through #lib/server/env.ts
#     (process.env + this file), never through $env/dynamic/private.

# ── Auth database (Better Auth tables only) ────────────────────────────────
# Connect as the dedicated auth role, never as the shared `veldrath` owner.
# The role's search_path must be `auth` (see web/shared/db/README.md).
# The repository-root compose stack maps Postgres to localhost:5433.
DATABASE_URL="postgres://veldrath_auth:veldrath_auth_dev@localhost:5433/veldrath"

# ── Origin ─────────────────────────────────────────────────────────────────
# adapter-node requires ORIGIN at runtime. Use http://localhost:5173 for
# `npm run dev`; the Docker container sets http://localhost:8081.
ORIGIN="http://localhost:5173"

# ── Better Auth ────────────────────────────────────────────────────────────
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of this app (cookies, OAuth callbacks, email links).
# Defaults to ORIGIN when empty.
BETTER_AUTH_URL=""

# ── Game JWT — MUST match the key Veldrath.Server actually loads ───────────
# The server validates Jwt__Key / Jwt__Issuer / Jwt__Audience; SvelteKit mints
# short-lived game tokens with the values below. In local development the root
# .env JWT_KEY overrides appsettings.Development.json, so copy that value here.
# A mismatch shows up as 401 on /api/characters (see docs/coolify-deployment.md).
JWT_KEY="dev-secret-key-change-in-production-must-be-32-chars"
JWT_ISSUER="Veldrath.Server"
JWT_AUDIENCE="Veldrath.Client"

# ── Public endpoints used by the browser ───────────────────────────────────
# Inlined at build time, so rebuild after changing them; in Docker pass them as
# build args (PUBLIC_API_URL / PUBLIC_HUB_URL).
PUBLIC_API_URL="http://localhost:9000"
PUBLIC_HUB_URL="http://localhost:9000/hubs/game"

# ── Server-side bridge to Veldrath.Server ──────────────────────────────────
# Used by foundry-bridge.ts, editorial-api.ts, game-api.ts, email.ts and
# game-request.ts. In Docker use http://server:8080; outside Docker use the
# local server URL. Unset falls back to PUBLIC_API_URL.
INTERNAL_BRIDGE_URL="http://localhost:9000"
# Must match InternalBridge__Token on Veldrath.Server (root .env INTERNAL_BRIDGE_TOKEN).
INTERNAL_BRIDGE_TOKEN="change-me_shared_internal_bridge_token"

# ── OAuth providers (Better Auth) ──────────────────────────────────────────
# Leave blank to disable a provider. Reuse the same OAuth apps as the .NET
# server and register these callbacks with each provider:
#   http://localhost:5173/api/auth/callback/{provider}   (npm run dev)
#   http://localhost:8081/api/auth/callback/{provider}   (Docker dev stack)
#   https://veldrath.com/api/auth/callback/{provider}    (production)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Optional single-tenant Microsoft apps; leave empty for consumers/common.
MICROSOFT_TENANT_ID=""

# ── adapter-node behind a reverse proxy (production only) ──────────────────
# Coolify/Traefik sets these; leave unset for local development.
# PROTOCOL_HEADER="x-forwarded-proto"
# HOST_HEADER="x-forwarded-host"
# ADDRESS_HEADER="x-forwarded-for"
# XFF_DEPTH="1"
