# .dockerignore — build context for web/client/Dockerfile and Dockerfile.dev.
# The build context is web/ (Coolify base directory /web, Dockerfile
# /client/Dockerfile), so project-relative paths below are relative to web/.

# Git / CI
.git
.gitignore
.gitattributes
.github

# Dependencies (installed inside the image)
node_modules
**/node_modules

# Env / secrets — exclude real .env files but KEEP the .env.example templates
# (server/Dockerfile copies server/.env.example as a fallback).
.env
.env.*
!.env.example
!**/.env.example

# Build output / artifacts
dist
**/dist
client/build
client/build-desktop
client/.svelte-kit
**/coverage
coverage

# Logs / temp
*.log
logs
npm-debug.log*
.DS_Store
Thumbs.db

# Editor / IDE
.vscode
.idea
