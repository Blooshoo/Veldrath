@page "/Game/CharacterSelect"
@using Veldrath.GameClient.Core.Payloads
@using Veldrath.GameClient.Core.Abstractions
@using Veldrath.Contracts.Characters
@using Veldrath.Contracts.Connection
@using Veldrath.Auth.Blazor
@using MudBlazor
@inject IGameHubConnectionService Hub
@inject IGameStateService GameState
@inject NavigationManager Navigation
@inject IGameApiClient Api
@inject AuthStateServiceBase Auth
@inject IConfiguration Configuration
@inject ILogger<CharacterSelect> Logger

@if (_isLoading)
{
    <div class="cs-loading d-flex flex-column align-center justify-center gap-4">
        <p>Connecting to game server...</p>
        <div class="spinner"></div>
    </div>
}
else if (_isWaitingForAuth)
{
    <div class="cs-error d-flex flex-column align-center justify-center gap-4">
        <p>Waiting for authentication... The server may be starting up.</p>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConnectAndLoadCharacters">Retry</MudButton>
        <MudButton Variant="Variant.Outlined" Href="/">Back to Home</MudButton>
    </div>
}
else if (_errorMessage is not null)
{
    <div class="cs-error d-flex flex-column align-center justify-center gap-4">
        <p>@_errorMessage</p>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConnectAndLoadCharacters">Retry</MudButton>
        <MudButton Variant="Variant.Outlined" Href="/">Back to Home</MudButton>
    </div>
}
else
{
    <div class="cs-container">
        <h1>Select Your Character</h1>

        @if (_characters.Count == 0)
        {
            <div class="cs-empty">
                <p>You have no characters yet.</p>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/Game/CreateCharacter">Create New Character</MudButton>
            </div>
        }
        else
        {
            <div class="cs-list d-flex flex-column gap-3">
                @foreach (var character in _characters)
                {
                    <div class="cs-card d-flex align-center justify-space-between @(_selectedCharacterId == character.Id.ToString() ? "cs-card-selected" : "")">
                        <div class="cs-card-info">
                            <h3>@character.Name</h3>
                            <p>@character.ClassName · Level @character.Level</p>
                            <p>⛁ @character.Experience XP</p>
                            <p class="cs-card-last-played">Last played: @character.LastPlayedAt.ToLocalTime().ToString("g")</p>
                            <p class="cs-card-last-played">@(IsOnline(character.Id) ? "● Online" : "○ Offline")</p>
                        </div>
                        <div class="cs-card-actions flex-shrink-0 d-flex flex-column gap-1">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="() => SelectCharacter(character.Id)"
                                       Disabled="@(_selectedCharacterId == character.Id.ToString() || _pendingDeleteId == character.Id)">
                                @(_selectedCharacterId == character.Id.ToString() ? "Selecting..." : "Select")
                            </MudButton>
                            @if (_pendingDeleteId == character.Id)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="() => ConfirmDeleteAsync(character)">
                                    Confirm
                                </MudButton>
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           OnClick="CancelDelete">
                                    Cancel
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="() => RequestDelete(character.Id)"
                                           Disabled="@(_isDeletingId == character.Id)">
                                    Delete
                                </MudButton>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="cs-footer d-flex gap-3 justify-center">
                <MudButton Variant="Variant.Outlined" Href="/Game/CreateCharacter">Create New Character</MudButton>
                <MudButton Variant="Variant.Outlined" Href="/">Back to Home</MudButton>
            </div>
        }
    </div>
}

@code {
    private List<CharacterDto> _characters = [];
    private bool _isLoading = true;
    private string? _errorMessage;
    private string? _selectedCharacterId;
    private bool _isWaitingForAuth;
    private CancellationTokenSource? _authTimeoutCts;
    private CancellationTokenSource? _selectTimeoutCts;
    private bool _hasLoadedCharacters;
    private readonly List<IDisposable> _hubSubscriptions = [];
    private readonly Dictionary<Guid, bool> _onlineStatuses = [];
    private Guid? _pendingDeleteId;
    private Guid? _isDeletingId;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Auth.OnChange += OnAuthStateChanged;
    }

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthReady)
        {
            _isLoading = false;
            _isWaitingForAuth = true;
            StartAuthTimeout();
            return;
        }

        if (!Auth.IsLoggedIn)
        {
            try { Navigation.NavigateTo("/login"); } catch (InvalidOperationException) { }
            return;
        }

        await ConnectAndLoadCharacters();
    }

    /// <summary>Starts a 10-second countdown; if auth is still not ready when it fires,
    /// sets <see cref="_errorMessage"/> so the error UI with Retry button appears.</summary>
    private async void StartAuthTimeout()
    {
        _authTimeoutCts?.Cancel();
        _authTimeoutCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(10), _authTimeoutCts.Token);
            if (!Auth.IsAuthReady)
            {
                _isWaitingForAuth = false;
                _errorMessage = "Authentication is taking longer than expected. The server may be starting up.";
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
            // Timeout was cancelled — auth became ready or component disposed.
        }
    }

    /// <summary>Reacts to auth state changes. Cancels any pending auth timeout and triggers
    /// character load when auth becomes ready after prerendering.
    /// Redirects to the login page when the auth state indicates the user is no longer logged in
    /// (e.g. after the <see cref="AuthDelegatingHandler"/> cleared stale tokens on a 401).</summary>
    private void OnAuthStateChanged()
    {
        if (!Auth.IsAuthReady)
            return;

        // Cancel any pending auth timeout since auth is now ready.
        _authTimeoutCts?.Cancel();

        // If the auth state was cleared (e.g. by the delegating handler after a renewal
        // failure), redirect to login so the user can re-authenticate.
        if (!Auth.IsLoggedIn)
        {
            try { Navigation.NavigateTo("/login"); } catch (InvalidOperationException) { }
            return;
        }

        if (!_hasLoadedCharacters && Auth.IsLoggedIn)
        {
            _isWaitingForAuth = false;
            _hasLoadedCharacters = true;
            InvokeAsync(async () =>
            {
                await ConnectAndLoadCharacters();
                StateHasChanged();
            });
            return;
        }

        InvokeAsync(StateHasChanged);
    }

    private async Task ConnectAndLoadCharacters()
    {
        _isLoading = true;
        _isWaitingForAuth = false;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            // Ensure the JWT is still fresh before connecting.
            var tokenValid = await Auth.TryRefreshAsync();
            if (!tokenValid || Auth.AccessToken is null)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            var serverUrl = Configuration["Veldrath:ServerUrl"];
            if (string.IsNullOrWhiteSpace(serverUrl))
                throw new InvalidOperationException(
                    "Veldrath:ServerUrl is not configured. Set it in appsettings.json, " +
                    "appsettings.{Environment}.json, or the Veldrath__ServerUrl environment variable.");

            // Register handler for ServerInfo — sets IsConnected = true on the GameState.
            _hubSubscriptions.Add(Hub.On<ServerInfoPayload>("ServerInfo", async payload =>
            {
                GameState.ApplyServerInfo(payload.ConnectionId);
                await InvokeAsync(StateHasChanged);
            }));

            // Register handler for CharacterSelected event BEFORE connecting.
            _hubSubscriptions.Add(Hub.On<CharacterSelectedPayload>("CharacterSelected", async payload =>
            {
                TryCancelSelectTimeout();
                GameState.ApplyCharacterSelected(payload);
                await InvokeAsync(() => Navigation.NavigateTo("/Game/Play"));
            }));

            // Track online/offline changes broadcast to this account's group.
            _hubSubscriptions.Add(Hub.On<CharacterStatusChangedPayload>("CharacterStatusChanged", async payload =>
            {
                _onlineStatuses[payload.CharacterId] = payload.IsOnline;
                await InvokeAsync(StateHasChanged);
            }));

            // Register handler for CharacterAlreadyActive before connecting.
            _hubSubscriptions.Add(Hub.On<string>("CharacterAlreadyActive", async error =>
            {
                Logger.LogWarning("CharacterAlreadyActive: {Error}", error);
                await InvokeAsync(() =>
                {
                    _errorMessage = "This character is already logged in elsewhere. Please wait or log out from that session.";
                    _selectedCharacterId = null;
                    StateHasChanged();
                });
            }));

            // Register handler for errors.
            _hubSubscriptions.Add(Hub.On<string>("Error", async error =>
            {
                Logger.LogWarning("Hub error: {Error}", error);
                await InvokeAsync(() =>
                {
                    _errorMessage = error;
                    StateHasChanged();
                });
            }));

            await Hub.ConnectAsync(serverUrl, Auth.AccessToken);

            // Load characters from REST API.
            _characters = await Api.GetCharactersAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to connect or load characters: {ExceptionType}: {ExceptionMessage}",
                ex.GetType().Name, ex.Message);
            _errorMessage = "Failed to connect to the game server. Please try again.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task SelectCharacter(Guid characterId)
    {
        _selectedCharacterId = characterId.ToString();
        _errorMessage = null;
        StateHasChanged();

        TryCancelSelectTimeout();
        _selectTimeoutCts?.Dispose();

        var timeoutCts = new CancellationTokenSource();
        _selectTimeoutCts = timeoutCts;

        try
        {
            await Hub.SendAsync("SelectCharacter", characterId);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to select character {CharacterId}.", characterId);
            _errorMessage = "Failed to select character. Please try again.";
            _selectedCharacterId = null;
            TryCancelSelectTimeout();
            StateHasChanged();
            return;
        }

        try
        {
            await Task.Delay(TimeSpan.FromSeconds(10), timeoutCts.Token);

            // The server never sent CharacterSelected within the timeout window.
            _selectedCharacterId = null;
            _errorMessage = "Connection timed out while selecting the character. Please try again.";
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // CharacterSelected arrived and cancelled the timeout.
        }
        finally
        {
            if (ReferenceEquals(_selectTimeoutCts, timeoutCts))
                _selectTimeoutCts = null;
            timeoutCts.Dispose();
        }
    }

    private void TryCancelSelectTimeout()
    {
        try
        {
            _selectTimeoutCts?.Cancel();
        }
        catch (ObjectDisposedException)
        {
            // The timeout already completed and was disposed.
        }
    }

    private void RequestDelete(Guid characterId)
    {
        _pendingDeleteId = characterId;
        _errorMessage = null;
        StateHasChanged();
    }

    private void CancelDelete()
    {
        _pendingDeleteId = null;
        StateHasChanged();
    }

    private async Task ConfirmDeleteAsync(CharacterDto character)
    {
        _isDeletingId = character.Id;
        StateHasChanged();

        try
        {
            if (await Api.DeleteCharacterAsync(character.Id))
            {
                _characters.RemoveAll(c => c.Id == character.Id);
                _onlineStatuses.Remove(character.Id);
            }
            else
            {
                _errorMessage = $"Failed to delete {character.Name}. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to delete character {CharacterId}.", character.Id);
            _errorMessage = $"Failed to delete {character.Name}. Please try again.";
        }
        finally
        {
            _pendingDeleteId = null;
            _isDeletingId = null;
            StateHasChanged();
        }
    }

    private bool IsOnline(Guid characterId) =>
        _onlineStatuses.TryGetValue(characterId, out var online) && online;

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        Auth.OnChange -= OnAuthStateChanged;
        _authTimeoutCts?.Cancel();
        _authTimeoutCts?.Dispose();
        TryCancelSelectTimeout();
        _selectTimeoutCts?.Dispose();
        _selectTimeoutCts = null;

        foreach (var sub in _hubSubscriptions)
        {
            sub.Dispose();
        }
        _hubSubscriptions.Clear();
    }
}
