@using Veldrath.GameClient.Core.Abstractions
@using Veldrath.GameClient.Components.Models
@using MudBlazor
@* Text-first combat view: enemy/player stat panels, a combat log, and contextual actions. *@
@inject IGameHubConnectionService Hub
@inject IGameStateService GameState
@implements IDisposable

@if (GameState.CombatEnemy is { } enemy)
{
    <div class="game-combat d-flex flex-column gap-3">
        <div class="game-combat-panels d-flex gap-3 flex-wrap">
            <div class="flex-grow-1">
                <TextPanel Title="Enemy" Subtitle="@($"Level {enemy.Level}")" Icon="@Icons.Material.Filled.Gavel">
                    <MudText Typo="Typo.h6" Class="mb-2">@enemy.EnemyName</MudText>
                    <StatTable Title="Vitals"
                               Stats="@EnemyStats"
                               EmptyText="No enemy vitals." />
                    <div class="mt-2">
                        <StatusBar Label="HP" Current="enemy.CurrentHealth" Max="enemy.MaxHealth" BarColor="@Color.Error" />
                    </div>
                </TextPanel>
            </div>

            <div class="flex-grow-1">
                <TextPanel Title="You" Subtitle="@(PlayerIsDead ? "Defeated" : "Standing")" Icon="@Icons.Material.Filled.Shield">
                    <StatTable Title="Vitals"
                               Stats="@PlayerStats"
                               EmptyText="No character vitals." />
                </TextPanel>
            </div>
        </div>

        <TextPanel Title="Combat Log" Icon="@Icons.Material.Filled.History" TestId="combat-log">
            @if (_log.Count == 0)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">No actions yet.</MudText>
            }
            else
            {
                <p class="game-combat-result">@_log[0]</p>
                @for (var i = 1; i < Math.Min(_log.Count, 8); i++)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="game-combat-log-entry">
                        @_log[i]
                    </MudText>
                }
            }
        </TextPanel>

        <TextPanel Title="Actions" Icon="@Icons.Material.Filled.Bolt">
            <div class="game-combat-actions d-flex gap-2 flex-wrap">
                <ActionBar ShowAttack="true"
                           ShowDefend="true"
                           ShowFlee="true"
                           ShowRespawn="@PlayerIsDead"
                           Disabled="@_actionInProgress"
                           OnAttack="PerformAttack"
                           OnDefend="PerformDefend"
                           OnFlee="PerformFlee"
                           OnRespawn="PerformRespawn" />
            </div>
        </TextPanel>

        @if (_showVictory)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="game-combat-victory">
                <div class="d-flex align-center justify-space-between gap-2">
                    <MudText Typo="Typo.h6">Victory</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="DismissVictory">
                        Continue
                    </MudButton>
                </div>
            </MudAlert>
        }
    </div>
}
else
{
    <TextPanel Title="Combat" Icon="@Icons.Material.Filled.Gavel">
        <div class="game-combat-empty">
            <MudText Typo="Typo.body2" Color="Color.Secondary">No enemy engaged.</MudText>
        </div>
    </TextPanel>
}

@code {
    private bool _actionInProgress;
    private bool _showVictory;
    private IDisposable? _stateSubscription;
    private readonly List<string> _log = [];
    private string? _lastLoggedResult;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        CaptureResult();
        _stateSubscription = GameState.OnStateChanged(() =>
        {
            CaptureResult();
            InvokeAsync(StateHasChanged);
        });
    }

    private bool PlayerIsDead => GameState.CurrentCharacterInfo?.CurrentHealth <= 0;

    private IReadOnlyList<StatEntry> EnemyStats =>
        GameState.CombatEnemy is { } enemy
            ?
            [
                new StatEntry("Level", enemy.Level.ToString(), Icons.Material.Filled.TrendingUp),
                new StatEntry("Health", $"{enemy.CurrentHealth} / {enemy.MaxHealth}", Icons.Material.Filled.Favorite, Color.Error),
            ]
            : [];

    private IReadOnlyList<StatEntry> PlayerStats =>
        GameState.CurrentCharacterInfo is { } character
            ?
            [
                new StatEntry("Level", character.Level.ToString(), Icons.Material.Filled.TrendingUp),
                new StatEntry("Health", $"{character.CurrentHealth} / {character.MaxHealth}", Icons.Material.Filled.Favorite, Color.Error),
                new StatEntry("Mana", $"{character.CurrentMana} / {character.MaxMana}", Icons.Material.Filled.AutoAwesome, Color.Info),
            ]
            : [];

    private void CaptureResult()
    {
        var result = GameState.LastCombatActionResult;
        if (string.IsNullOrWhiteSpace(result) ||
            string.Equals(result, _lastLoggedResult, StringComparison.Ordinal))
        {
            return;
        }

        _lastLoggedResult = result;
        _log.Insert(0, result);

        if (_log.Count > 50)
            _log.RemoveRange(50, _log.Count - 50);
    }

    private async Task PerformAttack()
    {
        _actionInProgress = true;
        try { await Hub.SendAsync("AttackEnemy"); }
        finally { _actionInProgress = false; }
    }

    private async Task PerformDefend()
    {
        _actionInProgress = true;
        try { await Hub.SendAsync("DefendAction"); }
        finally { _actionInProgress = false; }
    }

    private async Task PerformFlee()
    {
        _actionInProgress = true;
        try { await Hub.SendAsync("FleeFromCombat"); }
        finally { _actionInProgress = false; }
    }

    private async Task PerformRespawn()
    {
        _actionInProgress = true;
        try { await Hub.SendAsync("Respawn"); }
        finally { _actionInProgress = false; }
    }

    private void DismissVictory()
    {
        _showVictory = false;
    }

    /// <inheritdoc />
    public void Dispose() => _stateSubscription?.Dispose();
}
