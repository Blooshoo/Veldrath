@* Text footer: connection status, zone/map position, occupancy, and contextual actions. *@

<MudPaper Elevation="0" Outlined="true" Class="game-footer pa-2 mt-2">
    @if (ShowReconnectingBanner)
    {
        <MudStack Row AlignItems="AlignItems.Center" Class="mb-1">
            <MudProgressCircular Indeterminate Size="Size.Small" />
            <MudText Typo="Typo.caption">Reconnecting to game server...</MudText>
        </MudStack>
    }

    <div class="d-flex align-center gap-3 flex-wrap">
        <div class="d-flex align-center gap-1">
            <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Color="Color.Secondary" />
            <MudText Typo="Typo.body2">
                @(string.IsNullOrEmpty(GameState.CurrentZoneName) ? "No zone" : GameState.CurrentZoneName)
            </MudText>
        </div>

        <MudText Typo="Typo.body2" Color="Color.Secondary">@MapPositionText</MudText>

        @if (PlayerCount > 0)
        {
            <div class="d-flex align-center gap-1">
                <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" Color="Color.Secondary" />
                <MudText Typo="Typo.body2">@PlayerCount online</MudText>
            </div>
        }

        <MudSpacer />

        @if (GameState.IsInCombat)
        {
            <ActionBar ShowAttack="true" ShowDefend="true" ShowFlee="true"
                       ShowRespawn="GameState.CurrentCharacter.IsDead" />
        }
        else
        {
            <ActionBar ShowSearch="!GameState.IsInCombat" ShowRest="GameState.CurrentZone.HasInn"
                       OnSearch="SearchAsync" OnRest="RestAsync" />
        }

        <div class="game-header-divider" aria-hidden="true"></div>

        <div class="d-flex align-center gap-1" title="@StatusText">
            <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Style="@DotClass" />
            <MudText Typo="Typo.caption">@StatusText</MudText>
        </div>

        @if (PingMs > 0 && Status != StatusIndicator.Reconnecting)
        {
            <MudText Typo="Typo.caption">@($"{PingMs} ms")</MudText>
        }

        @if (!string.IsNullOrEmpty(GameState.ServerConnectionId))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                #@GameState.ServerConnectionId[..Math.Min(8, GameState.ServerConnectionId.Length)]
            </MudText>
        }
    </div>
</MudPaper>
