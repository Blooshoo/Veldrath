@* Shop overlay showing merchant catalog and buy/sell interface as text tables and detail panes. *@
@using Microsoft.Extensions.Logging
@using RealmEngine.Shared.Models
@using Veldrath.GameClient.Core.Abstractions
@using Veldrath.GameClient.Core.Payloads
@using MudBlazor
@inject IGameStateService GameState
@inject IGameHubConnectionService Hub
@inject ILogger<ShopOverlay> Logger
@implements IAsyncDisposable

<div class="shop-overlay d-flex flex-column gap-3">
    <TextPanel Title="Trade" Icon="@Icons.Material.Filled.Storefront" TestId="shop-summary">
        <StatTable Title="Merchant" Stats="@MerchantStats" />
    </TextPanel>

    <ItemTable Title="Merchant Wares"
               Icon="@Icons.Material.Filled.Storefront"
               Items="@CatalogRows"
               Selectable="true"
               OnSelect="SelectCatalogEntry"
               EmptyText="This merchant has nothing for sale."
               TestId="shop-catalog" />

    @if (_selectedEntry is { } entry)
    {
        <DetailPane Title="@entry.Name"
                    Subtitle="@entry.Rarity.ToString()"
                    Icon="@Icons.Material.Filled.Sell"
                    TestId="shop-detail">
            <StatTable Title="Purchase" Stats="@BuildPurchaseStats(entry)" />

            <div class="d-flex gap-2 mt-2">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           Size="Size.Small"
                           OnClick="() => BuyItem(entry)"
                           Disabled="@(!Hub.IsConnected || GameState.CurrentCharacterGold < entry.Price)">
                    Buy
                </MudButton>
            </div>
        </DetailPane>
    }

    <ItemTable Title="@($"Your Items ({GameState.InventoryItems.Count})")"
               Icon="@Icons.Material.Filled.Inventory2"
               Items="@InventoryRows"
               Selectable="true"
               OnSelect="SelectInventoryItem"
               EmptyText="You have no items to sell."
               TestId="shop-inventory" />

    @if (_selectedItem is not null)
    {
        <DetailPane Title="@_selectedItem.GetDisplayName()"
                    Subtitle="Sell"
                    Icon="@Icons.Material.Filled.Sell"
                    TestId="shop-sell-detail">
            <StatTable Title="Sale" Stats="@BuildSaleStats(_selectedItem)" />

            <div class="d-flex gap-2 mt-2">
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           OnClick="() => SellItem(_selectedItem, Math.Max(1, Math.Min(1, _selectedItem.Quantity)))"
                           Disabled="@(!Hub.IsConnected)">
                    Sell
                </MudButton>
            </div>
        </DetailPane>
    }

    @if (_lastMessage is not null)
    {
        <MudAlert Severity="@(_lastMessageIsError ? Severity.Error : Severity.Success)"
                  Dense="true"
                  Class="shop-message">
            @_lastMessage
        </MudAlert>
    }
</div>

@code {
    private readonly List<IDisposable> _hubSubscriptions = [];
    private ShopItemEntry? _selectedEntry;
    private Item? _selectedItem;
    private string? _lastMessage;
    private bool _lastMessageIsError;

    private IReadOnlyList<StatEntry> MerchantStats =>
    [
        new("Gold", $"{GameState.CurrentCharacterGold} g", Icons.Material.Filled.Paid),
        new("Wares", GameState.ShopCatalog.Count.ToString(), Icons.Material.Filled.Storefront),
        new("Carrying", GameState.InventoryItems.Count.ToString(), Icons.Material.Filled.Inventory2),
    ];

    private IReadOnlyList<ItemTableEntry> CatalogRows =>
        GameState.ShopCatalog
            .Select(entry => new ItemTableEntry(
                entry.Slug,
                entry.Name,
                1,
                entry.Rarity.ToString(),
                $"{entry.Price} g",
                Icons.Material.Filled.Sell))
            .ToList();

    private IReadOnlyList<ItemTableEntry> InventoryRows =>
        GameState.InventoryItems
            .Select(item => new ItemTableEntry(
                item.Slug,
                item.GetDisplayName(),
                item.Quantity,
                item.Type.ToString(),
                $"{item.Price / 2} g",
                ItemIcon(item)))
            .ToList();

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        // Subscribe to shop catalog updates from the hub.
        _hubSubscriptions.Add(Hub.On<ShopCatalogPayload>("ShopCatalogUpdated", payload =>
        {
            GameState.ApplyShopCatalogUpdated(payload.Catalog);
            return Task.CompletedTask;
        }));
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        foreach (var sub in _hubSubscriptions)
            sub.Dispose();
        _hubSubscriptions.Clear();

        await Task.CompletedTask;
    }

    private void SelectCatalogEntry(ItemTableEntry row)
    {
        _selectedEntry = GameState.ShopCatalog.FirstOrDefault(entry =>
            string.Equals(entry.Slug, row.Id, StringComparison.OrdinalIgnoreCase));
    }

    private void SelectInventoryItem(ItemTableEntry row)
    {
        _selectedItem = GameState.InventoryItems.FirstOrDefault(item =>
            string.Equals(item.Slug, row.Id, StringComparison.OrdinalIgnoreCase));
    }

    private IReadOnlyList<StatEntry> BuildPurchaseStats(ShopItemEntry entry) =>
    [
        new("Rarity", entry.Rarity.ToString(), Icons.Material.Filled.Star),
        new("Price", $"{entry.Price} g", Icons.Material.Filled.Paid),
        new("Affordable", GameState.CurrentCharacterGold >= entry.Price ? "Yes" : "No", Icons.Material.Filled.Savings),
    ];

    private IReadOnlyList<StatEntry> BuildSaleStats(Item item) =>
    [
        new("Quantity", item.Quantity.ToString(), Icons.Material.Filled.Numbers),
        new("Sell price", $"{item.Price / 2} g", Icons.Material.Filled.Paid),
        new("Type", item.Type.ToString(), ItemIcon(item)),
    ];

    private static string ItemIcon(Item item) => item.Type switch
    {
        ItemType.Weapon => Icons.Material.Filled.Gavel,
        ItemType.Shield or ItemType.OffHand => Icons.Material.Filled.Shield,
        ItemType.Consumable => Icons.Material.Filled.LocalDrink,
        ItemType.Material => Icons.Material.Filled.Category,
        _ => Icons.Material.Filled.Inventory2,
    };

    private async Task BuyItem(ShopItemEntry entry)
    {
        try
        {
            await Hub.SendAsync("BuyItem", new { ItemSlug = entry.Slug, Quantity = 1 });
            _lastMessage = $"Purchased {entry.Name}.";
            _lastMessageIsError = false;
            Logger.LogInformation("Bought {ItemName}", entry.Name);
        }
        catch (Exception ex)
        {
            _lastMessage = $"Failed to purchase {entry.Name}.";
            _lastMessageIsError = true;
            Logger.LogWarning(ex, "Failed to buy {ItemName}.", entry.Name);
        }
    }

    private async Task SellItem(Item item, int quantity)
    {
        try
        {
            await Hub.SendAsync("SellItem", new { ItemSlug = item.Slug, Quantity = quantity });
            _lastMessage = $"Sold {item.GetDisplayName()}.";
            _lastMessageIsError = false;
            Logger.LogInformation("Sold {ItemSlug}", item.Slug);
        }
        catch (Exception ex)
        {
            _lastMessage = $"Failed to sell {item.GetDisplayName()}.";
            _lastMessageIsError = true;
            Logger.LogWarning(ex, "Failed to sell {ItemSlug}.", item.Slug);
        }
    }
}
