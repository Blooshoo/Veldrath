@* A single label/value row used by text stat panels. *@

<div class="stat-row d-flex align-center justify-space-between gap-2 py-1" data-testid="@TestId">
    <div class="d-flex align-center gap-2">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <MudIcon Icon="@Icon" Size="Size.Small" Color="@IconColor" />
        }
        <MudText Typo="Typo.body2" Color="Color.Secondary">@Label</MudText>
    </div>
    <MudText Typo="Typo.body2" Color="@ValueColor" Class="stat-row-value">@Value</MudText>
</div>

@code {
    /// <summary>The row label.</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    /// <summary>The formatted value.</summary>
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;

    /// <summary>Optional Material icon key.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Colour applied to the icon.</summary>
    [Parameter] public Color IconColor { get; set; } = Color.Primary;

    /// <summary>Colour applied to the value text.</summary>
    [Parameter] public Color ValueColor { get; set; } = Color.Default;

    /// <summary>Optional test identifier applied to the row.</summary>
    [Parameter] public string? TestId { get; set; }
}
