@using Veldrath.GameClient.Components.Models
@* A compact text table for inventory, shop, and loot entries. *@

<TextPanel Title="@Title" Icon="@Icon" Dense="@Dense" TestId="@TestId">
    @if (Items.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@EmptyText</MudText>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Striped="true" Class="item-table" data-testid="@($"{TestId}-table")">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Type</th>
                    <th class="text-right">Qty</th>
                    @if (ShowValue)
                    {
                        <th class="text-right">Value</th>
                    }
                    @if (Selectable)
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Items)
                {
                    <tr data-testid="@($"item-{item.Id}")">
                        <td>
                            <div class="d-flex align-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(item.Icon))
                                {
                                    <MudIcon Icon="@item.Icon" Size="Size.Small" />
                                }
                                <MudText Typo="Typo.body2">@item.Name</MudText>
                                @if (item.IsEquipped)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">Equipped</MudChip>
                                }
                            </div>
                        </td>
                        <td><MudText Typo="Typo.body2" Color="Color.Secondary">@item.Type</MudText></td>
                        <td class="text-right"><MudText Typo="Typo.body2">@item.Quantity</MudText></td>
                        @if (ShowValue)
                        {
                            <td class="text-right"><MudText Typo="Typo.body2">@item.Value</MudText></td>
                        }
                        @if (Selectable)
                        {
                            <td class="text-right">
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="() => OnSelect.InvokeAsync(item)">
                                    Select
                                </MudButton>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</TextPanel>

@code {
    /// <summary>The table title.</summary>
    [Parameter] public string Title { get; set; } = "Items";

    /// <summary>Optional Material icon key.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>The rows to render.</summary>
    [Parameter] public IReadOnlyList<ItemTableEntry> Items { get; set; } = [];

    /// <summary>Text shown when <see cref="Items"/> is empty.</summary>
    [Parameter] public string EmptyText { get; set; } = "No items.";

    /// <summary>Whether to show the value column.</summary>
    [Parameter] public bool ShowValue { get; set; } = true;

    /// <summary>Whether to show a Select button per row.</summary>
    [Parameter] public bool Selectable { get; set; }

    /// <summary>Raised when a row is selected.</summary>
    [Parameter] public EventCallback<ItemTableEntry> OnSelect { get; set; }

    /// <summary>Uses compact spacing when <see langword="true"/>.</summary>
    [Parameter] public bool Dense { get; set; } = true;

    /// <summary>Optional test identifier applied to the panel.</summary>
    [Parameter] public string? TestId { get; set; }
}
