@using Veldrath.GameClient.Components.Models
@* A text table of labelled statistics. *@

<TextPanel Title="@Title" Icon="@Icon" Dense="@Dense" TestId="@TestId">
    @if (Stats.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@EmptyText</MudText>
    }
    else
    {
        @foreach (var stat in Stats)
        {
            <StatRow Label="@stat.Label"
                     Value="@stat.Value"
                     Icon="@stat.Icon"
                     ValueColor="@(stat.Color ?? Color.Default)" />
        }
    }
</TextPanel>

@code {
    /// <summary>The table title.</summary>
    [Parameter] public string Title { get; set; } = "Statistics";

    /// <summary>Optional Material icon key.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>The statistics to render.</summary>
    [Parameter] public IReadOnlyList<StatEntry> Stats { get; set; } = [];

    /// <summary>Text shown when <see cref="Stats"/> is empty.</summary>
    [Parameter] public string EmptyText { get; set; } = "No statistics available.";

    /// <summary>Uses compact spacing when <see langword="true"/>.</summary>
    [Parameter] public bool Dense { get; set; } = true;

    /// <summary>Optional test identifier applied to the panel.</summary>
    [Parameter] public string? TestId { get; set; }
}
