@* Context-sensitive action buttons plus a text-table ability hotbar with keybinds and icons. *@
@using MudBlazor
@using Veldrath.GameClient.Components.Models

<div class="action-bar-wrapper d-flex flex-column gap-2">
    @if (ShowHotbar && HotbarSlots.Count > 0)
    {
        <TextPanel Title="Abilities" Icon="@Icons.Material.Filled.AutoAwesome" Dense="true" TestId="hotbar">
            <MudSimpleTable Dense="true" Hover="true" Class="hotbar-table" data-testid="hotbar-table">
                <thead>
                    <tr>
                        <th class="text-center">Key</th>
                        <th>Ability</th>
                        <th>Status</th>
                        <th class="text-right">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var slot in HotbarSlots)
                    {
                        <tr class="hotbar-slot @slot.CssClass" data-testid="@($"hotbar-slot-{slot.SlotNumber}")">
                            <td class="text-center">
                                <kbd class="hotbar-slot-key">@slot.KeyBind</kbd>
                            </td>
                            <td>
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@SlotIcon(slot)" Size="Size.Small" Color="@SlotColor(slot)" />
                                    <MudText Typo="Typo.body2">@(slot.IsEmpty ? "Empty slot" : slot.Name)</MudText>
                                </div>
                            </td>
                            <td>
                                @if (slot.IsEmpty)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Unassigned</MudText>
                                }
                                else if (!slot.IsAvailable && slot.CooldownRemaining > 0)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Info">Cooldown @slot.CooldownRemaining s</MudText>
                                }
                                else if (!slot.IsAvailable)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Warning">Unavailable</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Success">Ready</MudText>
                                }
                            </td>
                            <td class="text-right">
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           Color="Color.Primary"
                                           OnClick="() => OnUseAbility.InvokeAsync(slot.AbilityId)"
                                           Disabled="@(slot.IsEmpty || !slot.IsAvailable)">
                                    Use
                                </MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </TextPanel>
    }

    @* Context-sensitive action buttons *@
    <div class="action-bar d-flex gap-2 align-center flex-wrap">
        @if (ShowAttack)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="OnAttack"
                       Disabled="@Disabled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Gavel"
                       Class="action-btn-attack">
                Attack
            </MudButton>
        }
        @if (ShowDefend)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       OnClick="OnDefend"
                       Disabled="@Disabled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Shield"
                       Class="action-btn-defend">
                Defend
            </MudButton>
        }
        @if (ShowFlee)
        {
            <MudButton Variant="Variant.Outlined"
                       OnClick="OnFlee"
                       Disabled="@Disabled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.DirectionsRun"
                       Class="action-btn-flee">
                Flee
            </MudButton>
        }
        @if (ShowRespawn)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       OnClick="OnRespawn"
                       Disabled="@Disabled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Refresh">
                Respawn
            </MudButton>
        }
        @if (ShowSearch)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       OnClick="OnSearch"
                       Disabled="@Disabled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Search">
                Search
            </MudButton>
        }
        @if (ShowRest)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Tertiary"
                       OnClick="OnRest"
                       Disabled="@Disabled"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Hotel">
                Rest
            </MudButton>
        }
    </div>
</div>

@code {
    /// <summary>Whether to show the hotbar ability table.</summary>
    [Parameter] public bool ShowHotbar { get; set; } = true;

    /// <summary>The list of hotbar ability slots to display.</summary>
    [Parameter] public List<HotbarAbility> HotbarSlots { get; set; } = [];

    /// <summary>Whether to show the Attack button.</summary>
    [Parameter] public bool ShowAttack { get; set; }

    /// <summary>Whether to show the Defend button.</summary>
    [Parameter] public bool ShowDefend { get; set; }

    /// <summary>Whether to show the Flee button.</summary>
    [Parameter] public bool ShowFlee { get; set; }

    /// <summary>Whether to show the Respawn button.</summary>
    [Parameter] public bool ShowRespawn { get; set; }

    /// <summary>Whether to show the Search button (exploration mode).</summary>
    [Parameter] public bool ShowSearch { get; set; }

    /// <summary>Whether to show the Rest button (inn/exploration mode).</summary>
    [Parameter] public bool ShowRest { get; set; }

    /// <summary>Whether action buttons are disabled (e.g. during combat turn processing).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Callback when the Attack button is clicked.</summary>
    [Parameter] public EventCallback OnAttack { get; set; }

    /// <summary>Callback when the Defend button is clicked.</summary>
    [Parameter] public EventCallback OnDefend { get; set; }

    /// <summary>Callback when the Flee button is clicked.</summary>
    [Parameter] public EventCallback OnFlee { get; set; }

    /// <summary>Callback when the Respawn button is clicked.</summary>
    [Parameter] public EventCallback OnRespawn { get; set; }

    /// <summary>Callback when the Search button is clicked.</summary>
    [Parameter] public EventCallback OnSearch { get; set; }

    /// <summary>Callback when the Rest button is clicked.</summary>
    [Parameter] public EventCallback OnRest { get; set; }

    /// <summary>
    /// Callback invoked when a hotbar ability's Use action is clicked.
    /// The parameter is the <see cref="HotbarAbility.AbilityId"/>.
    /// </summary>
    [Parameter] public EventCallback<string?> OnUseAbility { get; set; }

    private static string SlotIcon(HotbarAbility slot) =>
        slot.IsEmpty
            ? Icons.Material.Filled.RemoveCircleOutline
            : slot.IsAvailable
                ? Icons.Material.Filled.AutoAwesome
                : Icons.Material.Filled.HourglassBottom;

    private static Color SlotColor(HotbarAbility slot) =>
        slot.IsEmpty
            ? Color.Default
            : slot.IsAvailable
                ? Color.Primary
                : Color.Info;
}
