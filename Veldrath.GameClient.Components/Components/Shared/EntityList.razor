@using Veldrath.GameClient.Components.Models
@* A selectable text list of named entities (zones, locations, enemies, NPCs). *@

<TextPanel Title="@Title" Icon="@Icon" Dense="@Dense" TestId="@TestId">
    @if (Items.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@EmptyText</MudText>
    }
    else
    {
        <div class="entity-list d-flex flex-column" role="list">
            @foreach (var item in Items)
            {
                <button type="button"
                        class="entity-list-item d-flex align-center gap-2 @(item.IsSelected ? "entity-list-item-selected" : string.Empty)"
                        data-testid="@($"entity-{item.Id}")"
                        role="listitem"
                        disabled="@item.IsDisabled"
                        @onclick="() => HandleSelect(item)">
                    @if (!string.IsNullOrWhiteSpace(item.Icon))
                    {
                        <MudIcon Icon="@item.Icon" Size="Size.Small" Color="@(item.IsSelected ? Color.Primary : Color.Default)" />
                    }
                    <span class="d-flex flex-column align-start flex-grow-1">
                        <MudText Typo="Typo.body2" Color="@(item.IsSelected ? Color.Primary : Color.Default)">@item.Name</MudText>
                        @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@item.Subtitle</MudText>
                        }
                    </span>
                    @if (!string.IsNullOrWhiteSpace(item.Badge))
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@item.Badge</MudChip>
                    }
                </button>
            }
        </div>
    }
</TextPanel>

@code {
    /// <summary>The list title.</summary>
    [Parameter] public string Title { get; set; } = "Entities";

    /// <summary>Optional Material icon key.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>The entities to render.</summary>
    [Parameter] public IReadOnlyList<EntityListItem> Items { get; set; } = [];

    /// <summary>Text shown when <see cref="Items"/> is empty.</summary>
    [Parameter] public string EmptyText { get; set; } = "Nothing here.";

    /// <summary>Raised when a row is selected.</summary>
    [Parameter] public EventCallback<EntityListItem> OnSelect { get; set; }

    /// <summary>Uses compact spacing when <see langword="true"/>.</summary>
    [Parameter] public bool Dense { get; set; } = true;

    /// <summary>Optional test identifier applied to the panel.</summary>
    [Parameter] public string? TestId { get; set; }

    private Task HandleSelect(EntityListItem item) =>
        item.IsDisabled ? Task.CompletedTask : OnSelect.InvokeAsync(item);
}
