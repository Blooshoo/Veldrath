@* Text-first panel: an outlined surface with an icon, title, subtitle, actions, and body content. *@

<div class="text-panel-host" data-testid="@TestId">
    <MudPaper Elevation="0" Outlined="true" Class="@($"text-panel {Class}")">
        <div class="text-panel-header d-flex align-center justify-space-between gap-2 @(Dense ? "pa-2" : "pa-3")">
            <div class="d-flex align-center gap-2">
                @if (!string.IsNullOrWhiteSpace(Icon))
                {
                    <MudIcon Icon="@Icon" Size="Size.Small" Color="Color.Primary" />
                }
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.subtitle1" Class="text-panel-title">@Title</MudText>
                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@Subtitle</MudText>
                    }
                </div>
            </div>
            @if (Actions is not null)
            {
                <div class="d-flex align-center gap-1">@Actions</div>
            }
        </div>
        @if (ChildContent is not null)
        {
            <MudDivider />
            <div class="text-panel-body @(Dense ? "pa-2" : "pa-3")">
                @ChildContent
            </div>
        }
    </MudPaper>
</div>

@code {
    /// <summary>The panel title.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Optional supporting text below the title.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Optional Material icon key shown before the title.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Optional actions rendered at the right side of the header.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>The panel body.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Uses compact padding when <see langword="true"/>.</summary>
    [Parameter] public bool Dense { get; set; }

    /// <summary>Additional CSS classes for the panel.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Optional test identifier applied to the host element.</summary>
    [Parameter] public string? TestId { get; set; }
}
