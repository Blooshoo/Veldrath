@using Veldrath.Contracts.Map
@using Veldrath.GameClient.Components.Layout
@* Text-first cardinal map view. Nodes are compact cards; connectors carry direction labels. *@

@if (Map is null || _placements.Count == 0)
{
    <TextPanel Title="Map" Icon="@Icons.Material.Filled.Map" TestId="cardinal-map-empty">
        <MudText Typo="Typo.body2" Color="Color.Secondary">No map graph loaded.</MudText>
    </TextPanel>
}
else
{
    <TextPanel Title="@Map.Name" Subtitle="@MapSubtitle" Icon="@Icons.Material.Filled.Map" TestId="cardinal-map-panel">
        <div class="cardinal-map-toolbar d-flex align-center gap-2 flex-wrap">
            <span class="map-legend-item">
                <span class="map-legend-dot map-legend-current"></span>Current
            </span>
            <span class="map-legend-item">
                <span class="map-legend-dot map-legend-selected"></span>Selected
            </span>
            <span class="map-legend-item">
                <span class="map-legend-dot map-legend-exit"></span>Exit
            </span>
            <MudSpacer />
            <MudText Typo="Typo.caption" Color="Color.Secondary">Arrow keys select · Enter travels</MudText>
        </div>

        <div class="cardinal-map-viewport"
             tabindex="0"
             data-testid="cardinal-map"
             @onkeydown="HandleKeyDown">
            <div class="cardinal-map-canvas" style="@CanvasStyle">
                @foreach (var connector in _connectors)
                {
                    <div class="@ConnectorClass(connector)"
                         style="@ConnectorStyle(connector)"
                         title="@ConnectorTitle(connector)"
                         aria-hidden="true"></div>
                    <span class="map-connector-label"
                          style="@ConnectorLabelStyle(connector)"
                          aria-hidden="true">@DirectionShort(connector.Direction)</span>
                }

                @foreach (var placement in _placements)
                {
                    var node = FindNode(placement.NodeId);
                    if (node is null)
                        continue;

                    var pixel = new NodePixel(
                        (placement.X - _minX) * CellWidth + CanvasPadding,
                        (placement.Y - _minY) * CellHeight + CanvasPadding);

                    <button type="button"
                            class="@NodeClass(node, CurrentNodeId, SelectedNodeId)"
                            style="@($"left:{pixel.Left}px;top:{pixel.Top}px;")"
                            data-testid="@($"map-node-{node.Id}")"
                            title="@node.Description"
                            @onclick="() => SelectNodeAsync(node)">
                        <span class="map-node-heading d-flex align-center gap-1">
                            <MudIcon Icon="@IconFor(node)" Size="Size.Small" Color="Color.Primary" />
                            <span class="map-node-name">@node.DisplayName</span>
                        </span>
                        <span class="map-node-meta d-flex align-center gap-1">
                            <span class="map-node-type">@node.NodeType</span>
                            @if (node.IsEntryPoint)
                            {
                                <span class="map-node-badge map-node-badge-entry">Entry</span>
                            }
                            else if (node.IsExitPoint)
                            {
                                <span class="map-node-badge map-node-badge-exit">Exit</span>
                            }
                        </span>
                        @if (string.Equals(node.Id, CurrentNodeId, StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="map-node-current-label">● You are here</span>
                        }
                    </button>
                }
            </div>
        </div>
    </TextPanel>
}
