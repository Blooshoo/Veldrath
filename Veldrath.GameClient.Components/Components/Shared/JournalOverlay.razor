@* Journal / quest log as text lists with a detail pane. *@
@using Microsoft.Extensions.Logging
@using Veldrath.GameClient.Core.Abstractions
@using Veldrath.GameClient.Components.Models
@using MudBlazor
@inject IGameHubConnectionService Hub
@inject IGameStateService GameState
@inject ILogger<JournalOverlay> Logger
@implements IAsyncDisposable

<div class="journal-overlay d-flex flex-column gap-3">
    <EntityList Title="@($"Active Quests ({GameState.QuestLog.Count})")"
                Icon="@Icons.Material.Filled.MenuBook"
                Items="@ActiveQuestItems"
                EmptyText="No active quests. Find an NPC in town to get started!"
                OnSelect="SelectQuest" />

    @if (_selectedQuest is not null)
    {
        <DetailPane Title="@_selectedQuest.Title"
                    Subtitle="@($"{_selectedQuest.Progress} / {_selectedQuest.Total}")"
                    Description="@_selectedQuest.Description"
                    Icon="@Icons.Material.Filled.Flag"
                    TestId="journal-quest-detail">
            <TextPanel Title="Objectives" Dense="true">
                @if (_selectedQuest.Objectives.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">No specific objectives listed.</MudText>
                }
                else
                {
                    @foreach (var (objectiveName, required) in _selectedQuest.Objectives)
                    {
                        var progress = _selectedQuest.ProgressData.GetValueOrDefault(objectiveName, 0);
                        var done = progress >= required;
                        <StatRow Label="@objectiveName"
                                 Value="@($"{progress} / {required}")"
                                 Icon="@(done ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)"
                                 IconColor="@(done ? Color.Success : Color.Default)" />
                    }
                }
            </TextPanel>

            <TextPanel Title="Rewards" Dense="true" Class="mt-2">
                <StatRow Label="Experience" Value="@($"{_selectedQuest.XpReward} XP")" Icon="@Icons.Material.Filled.TrendingUp" />
                <StatRow Label="Gold" Value="@($"{_selectedQuest.GoldReward} gold")" Icon="@Icons.Material.Outlined.Diamond" />
            </TextPanel>
        </DetailPane>
    }

    @if (GameState.CompletedQuests.Count > 0)
    {
        <EntityList Title="@($"Completed Quests ({GameState.CompletedQuests.Count})")"
                    Icon="@Icons.Material.Filled.TaskAlt"
                    Items="@CompletedQuestItems"
                    EmptyText="No completed quests yet." />
    }
</div>

@code {
    private QuestLogEntry? _selectedQuest;
    private IDisposable? _questLogSubscription;

    /// <summary>
    /// Hub event payload received when the quest log is sent from the server.
    /// </summary>
    /// <param name="Active">The currently active quests.</param>
    /// <param name="Completed">The completed quests.</param>
    public sealed record QuestLogPayload(
        IReadOnlyList<QuestLogEntry> Active,
        IReadOnlyList<QuestLogEntry> Completed);

    private IReadOnlyList<EntityListItem> ActiveQuestItems =>
        GameState.QuestLog
            .Select(quest => new EntityListItem(
                quest.Title,
                quest.Title,
                $"{quest.Progress} / {quest.Total}",
                Icons.Material.Filled.Flag,
                quest.IsComplete ? "Complete" : null,
                IsSelected: string.Equals(quest.Title, _selectedQuest?.Title, StringComparison.Ordinal)))
            .ToList();

    private IReadOnlyList<EntityListItem> CompletedQuestItems =>
        GameState.CompletedQuests
            .Select(quest => new EntityListItem(
                quest.Title,
                quest.Title,
                quest.Description,
                Icons.Material.Filled.CheckCircle))
            .ToList();

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        _questLogSubscription = Hub.On<QuestLogPayload>("QuestLogReceived", payload =>
        {
            GameState.ApplyQuestLogUpdated(payload.Active, payload.Completed);
            _ = InvokeAsync(StateHasChanged);
            return Task.CompletedTask;
        });

        _ = RequestQuestLogAsync();
    }

    private async Task RequestQuestLogAsync()
    {
        try
        {
            if (Hub.IsConnected)
                await Hub.SendAsync("GetQuestLog");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to request quest log from server.");
        }
    }

    private void SelectQuest(EntityListItem item)
    {
        _selectedQuest = GameState.QuestLog.FirstOrDefault(quest =>
            string.Equals(quest.Title, item.Id, StringComparison.Ordinal));
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        _questLogSubscription?.Dispose();
        await Task.CompletedTask;
    }
}
