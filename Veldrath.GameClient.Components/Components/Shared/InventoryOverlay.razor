@* Inventory overlay showing the character's inventory grid and equipped items. *@
@using Microsoft.Extensions.Logging
@using RealmEngine.Shared.Models
@using Veldrath.GameClient.Core.Payloads
@using MudBlazor
@inject IGameStateService GameState
@inject IGameHubConnectionService Hub
@inject ILogger<InventoryOverlay> Logger
@implements IAsyncDisposable

<div class="inventory-overlay d-flex flex-column gap-3">
    <TextPanel Title="Equipment" Icon="@Icons.Material.Filled.Shield">
        <StatTable Title="Equipped" Stats="@EquipmentStats" EmptyText="No equipment." />
    </TextPanel>

    <ItemTable Title="@($"Inventory ({GameState.InventoryItems.Count} items)")"
               Icon="@Icons.Material.Filled.Inventory2"
               Items="@InventoryRows"
               Selectable="true"
               OnSelect="SelectInventoryItem"
               EmptyText="Your inventory is empty." />

    @if (_selectedItem is not null)
    {
        <DetailPane Title="@_selectedItem.GetDisplayName()"
                    Subtitle="@_selectedItem.Rarity.ToString()"
                    Icon="@ItemIcon(_selectedItem)"
                    Description="@_selectedItem.Description"
                    TestId="inventory-detail">
            @if (!string.IsNullOrEmpty(_selectedItem.Lore))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">"@_selectedItem.Lore"</MudText>
            }

            <StatTable Title="Item Stats" Stats="@SelectedItemStats" />

            <div class="d-flex gap-2 mt-2">
                @if (IsEquippable(_selectedItem.Type))
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               OnClick="() => EquipItem(_selectedItem)"
                               Disabled="@(!Hub.IsConnected)">
                        Equip
                    </MudButton>
                }
                <MudButton Variant="Variant.Filled"
                           Color="Color.Error"
                           Size="Size.Small"
                           OnClick="() => DropItem(_selectedItem)"
                           Disabled="@(!Hub.IsConnected)">
                    Drop
                </MudButton>
            </div>
        </DetailPane>
    }
</div>

@code {
    private readonly List<IDisposable> _hubSubscriptions = [];
    private Item? _selectedItem;

    private static readonly string[] EquipmentSlots =
        ["Head", "Chest", "MainHand", "OffHand", "Legs", "Feet", "Ring", "Amulet"];

    private IReadOnlyList<StatEntry> EquipmentStats =>
        EquipmentSlots
            .Select(slot => new StatEntry(
                slot,
                GameState.EquippedItems.TryGetValue(slot, out var item)
                    ? item.GetDisplayName()
                    : "—",
                Icons.Material.Filled.Shield))
            .ToList();

    private IReadOnlyList<ItemTableEntry> InventoryRows =>
        GameState.InventoryItems
            .Select(item => new ItemTableEntry(
                item.Slug,
                item.GetDisplayName(),
                item.Quantity,
                item.Type.ToString(),
                $"{item.Price} g",
                ItemIcon(item),
                IsEquipped: GameState.EquippedItems.Values.Any(equipped =>
                    string.Equals(equipped.Slug, item.Slug, StringComparison.OrdinalIgnoreCase))))
            .ToList();

    private IReadOnlyList<StatEntry> SelectedItemStats
    {
        get
        {
            if (_selectedItem is null)
                return [];

            var stats = new List<StatEntry>
            {
                new("Rarity", _selectedItem.Rarity.ToString(), Icons.Material.Filled.Star),
                new("Weight", _selectedItem.Weight.ToString("F1"), Icons.Material.Filled.Scale),
                new("Value", $"{_selectedItem.Price} gold", Icons.Material.Outlined.Diamond),
            };

            if (_selectedItem.Type == ItemType.Weapon && _selectedItem.Damage is not null)
            {
                stats.Add(new StatEntry(
                    "Damage",
                    $"{_selectedItem.Damage.Min}–{_selectedItem.Damage.Max}",
                    Icons.Material.Filled.Gavel));
            }

            if (IsArmorType(_selectedItem.Type) && !string.IsNullOrEmpty(_selectedItem.ArmorClass))
            {
                stats.Add(new StatEntry(
                    "Armor",
                    _selectedItem.ArmorClass,
                    Icons.Material.Filled.Shield));
            }

            return stats;
        }
    }

    private void SelectInventoryItem(ItemTableEntry entry)
    {
        _selectedItem = GameState.InventoryItems.FirstOrDefault(item =>
            string.Equals(item.Slug, entry.Id, StringComparison.OrdinalIgnoreCase));
    }

    private static string ItemIcon(Item item) => item.Type switch
    {
        ItemType.Weapon => Icons.Material.Filled.Gavel,
        ItemType.Shield or ItemType.OffHand => Icons.Material.Filled.Shield,
        ItemType.Consumable => Icons.Material.Filled.LocalDrink,
        ItemType.Material => Icons.Material.Filled.Category,
        _ => Icons.Material.Filled.Inventory2,
    };

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        // Subscribe to hub events that keep inventory state in sync with the server.
        _hubSubscriptions.Add(Hub.On<InventoryUpdatedPayload>("InventoryUpdated", payload =>
        {
            GameState.ApplyInventoryUpdated(payload.InventoryItems, payload.EquippedItems);
            return Task.CompletedTask;
        }));

        _hubSubscriptions.Add(Hub.On<EquipmentChangedPayload>("EquipmentChanged", payload =>
        {
            GameState.ApplyEquipmentChanged(payload.Slot, payload.Item);
            return Task.CompletedTask;
        }));

        // G66: Request the character's inventory from the server on component init.
        _ = FetchInventoryAsync();
    }

    private async Task FetchInventoryAsync()
    {
        try
        {
            if (Hub.IsConnected)
                await Hub.SendAsync("GetInventory");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to request inventory.");
        }
    }

    /// <inheritdoc />
    public async ValueTask DisposeAsync()
    {
        foreach (var sub in _hubSubscriptions)
            sub.Dispose();
        _hubSubscriptions.Clear();

        await Task.CompletedTask;
    }

    private void SelectItem(Item item)
    {
        _selectedItem = item;
    }

    private async Task EquipItem(Item item)
    {
        try
        {
            await Hub.SendAsync("EquipItem", new { Slot = GuessSlot(item.Type, item.WeaponType), ItemRef = item.Slug });
            Logger.LogInformation("Equipped {ItemName}", item.Name);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to equip {ItemName}.", item.Name);
        }
    }

    private async Task DropItem(Item item)
    {
        try
        {
            await Hub.SendAsync("DropItem", item.Slug);
            if (_selectedItem == item) _selectedItem = null;
            Logger.LogInformation("Dropped {ItemName}", item.Name);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to drop {ItemName}.", item.Name);
        }
    }

    private static bool IsEquippable(ItemType type) => type is ItemType.Weapon or ItemType.Shield or ItemType.OffHand
        or ItemType.Helmet or ItemType.Chest or ItemType.Legs or ItemType.Boots
        or ItemType.Shoulders or ItemType.Bracers or ItemType.Gloves or ItemType.Belt
        or ItemType.Necklace or ItemType.Ring;

    private static bool IsArmorType(ItemType type) => type is ItemType.Helmet or ItemType.Chest or ItemType.Legs
        or ItemType.Boots or ItemType.Shoulders or ItemType.Bracers or ItemType.Gloves or ItemType.Belt
        or ItemType.Necklace or ItemType.Ring;

    private static string GuessSlot(ItemType type, string? weaponType)
    {
        if (type is ItemType.Shield or ItemType.OffHand)
            return "OffHand";

        if (IsArmorType(type))
        {
            return type switch
            {
                ItemType.Helmet => "Head",
                ItemType.Chest => "Chest",
                ItemType.Legs => "Legs",
                ItemType.Boots => "Feet",
                ItemType.Shoulders => "Chest",
                ItemType.Bracers => "Chest",
                ItemType.Gloves => "Chest",
                ItemType.Belt => "Chest",
                ItemType.Necklace => "Amulet",
                ItemType.Ring => "Ring",
                _ => "Chest"
            };
        }
        if (weaponType?.Contains("shield", StringComparison.OrdinalIgnoreCase) == true) return "OffHand";
        return "MainHand";
    }

    private static string GetRarityClass(ItemRarity rarity) => rarity switch
    {
        ItemRarity.Common => "rarity-common",
        ItemRarity.Uncommon => "rarity-uncommon",
        ItemRarity.Rare => "rarity-rare",
        ItemRarity.Epic => "rarity-epic",
        ItemRarity.Legendary => "rarity-legendary",
        _ => "rarity-common"
    };

    private static string BuildTooltip(Item item)
    {
        var lines = new List<string>
        {
            item.GetDisplayName(),
            $"Rarity: {item.Rarity}",
            $"Weight: {item.Weight:F1}",
            $"Value: {item.Price} gold"
        };
        if (item.Type == ItemType.Weapon && item.Damage is not null)
            lines.Add($"Damage: {item.Damage.Min}–{item.Damage.Max}");
        if (!string.IsNullOrEmpty(item.Description))
            lines.Add(item.Description);
        return string.Join("\n", lines);
    }
}
