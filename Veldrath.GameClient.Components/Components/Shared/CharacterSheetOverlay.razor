@* Character sheet as text stat panels. *@
@using Veldrath.GameClient.Core.Abstractions
@using Veldrath.GameClient.Components.Models
@using MudBlazor
@inject IGameStateService GameState

<div class="character-sheet-overlay d-flex flex-column gap-3">
    @if (GameState.CurrentCharacterInfo is { } info && GameState.CurrentCharacter is { } state)
    {
        <TextPanel Title="@info.Name"
                   Subtitle="@($"{info.ClassName} · Level {state.Level}")"
                   Icon="@Icons.Material.Filled.Person"
                   TestId="character-sheet">
            <StatTable Title="Vitals" Stats="@VitalStats" EmptyText="No vitals available." />
        </TextPanel>

        <div class="d-flex gap-3 flex-wrap">
            <div class="flex-grow-1">
                <StatTable Title="Attributes" Stats="@AttributeStats" Icon="@Icons.Material.Filled.Insights" />
            </div>
            <div class="flex-grow-1">
                <StatTable Title="Progression" Stats="@ProgressionStats" Icon="@Icons.Material.Filled.TrendingUp" />
            </div>
        </div>
    }
    else
    {
        <TextPanel Title="Character Sheet" Icon="@Icons.Material.Filled.Person">
            <MudText Typo="Typo.body2" Color="Color.Secondary">No character selected.</MudText>
        </TextPanel>
    }
</div>

@code {
    private IReadOnlyList<StatEntry> VitalStats =>
        GameState.CurrentCharacter is { } state
            ?
            [
                new StatEntry("Health", $"{state.CurrentHealth} / {state.MaxHealth}", Icons.Material.Filled.Favorite, Color.Error),
                new StatEntry("Mana", $"{state.CurrentMana} / {state.MaxMana}", Icons.Material.Filled.AutoAwesome, Color.Info),
                new StatEntry("Experience", state.XP.ToString("N0"), Icons.Material.Filled.TrendingUp, Color.Success),
            ]
            : [];

    private IReadOnlyList<StatEntry> AttributeStats =>
        GameState.CurrentCharacter is { } state
            ?
            [
                new StatEntry("Strength", state.Strength.ToString(), Icons.Material.Filled.FitnessCenter),
                new StatEntry("Dexterity", state.Dexterity.ToString(), Icons.Material.Filled.DirectionsRun),
                new StatEntry("Constitution", state.Constitution.ToString(), Icons.Material.Filled.FavoriteBorder),
                new StatEntry("Intelligence", state.Intelligence.ToString(), Icons.Material.Filled.Psychology),
                new StatEntry("Wisdom", state.Wisdom.ToString(), Icons.Material.Filled.Visibility),
                new StatEntry("Charisma", state.Charisma.ToString(), Icons.Material.Filled.RecordVoiceOver),
            ]
            : [];

    private IReadOnlyList<StatEntry> ProgressionStats =>
        GameState.CurrentCharacter is { } state
            ?
            [
                new StatEntry("Level", state.Level.ToString(), Icons.Material.Filled.MilitaryTech),
                new StatEntry("Gold", $"{state.Gold:N0}", Icons.Material.Outlined.Diamond, Color.Warning),
                new StatEntry("Unspent points", state.UnspentAttributePoints.ToString(), Icons.Material.Filled.AddCircle),
                new StatEntry("Next level", $"{GameState.CurrentCharacterInfo?.EffectiveExperienceToNextLevel:N0} XP", Icons.Material.Filled.Flag),
            ]
            : [];
}
