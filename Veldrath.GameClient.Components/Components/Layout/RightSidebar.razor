@using Veldrath.GameClient.Core.Abstractions
@using Microsoft.Extensions.Logging
@using MudBlazor
@* ── RIGHT SIDEBAR: text chat console ── *@
@inject NavigationManager Navigation
@inject ILogger<RightSidebar> Logger
@inject IGameApiClient Api

<TextPanel Title="Chat" Icon="@Icons.Material.Filled.Chat" Class="game-sidebar game-sidebar-right">
    <MudTabs Elevation="0" Rounded="true">
        @foreach (var channel in ChannelNames)
        {
            <MudTabPanel Text="@channel" OnClick="() => SetActiveChannel(channel)">
                <div class="game-chat-log d-flex flex-column pt-2">
                    @if (FilteredMessages.Any())
                    {
                        @foreach (var msg in FilteredMessages)
                        {
                            <div class="game-chat-message d-flex align-baseline gap-1 @msg.ChannelClass">
                                <span class="game-chat-timestamp">@msg.TimestampFormatted</span>
                                <span class="game-chat-channel">[@msg.Channel]</span>
                                <span class="game-chat-sender">@msg.Sender:</span>
                                <span class="game-chat-text">@msg.Message</span>
                            </div>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No messages in this channel.</MudText>
                    }
                </div>
            </MudTabPanel>
        }
    </MudTabs>

    <div class="d-flex align-center gap-2 mt-2" @onkeydown="HandleKeyDown">
        <MudTextField T="string"
                      @bind-Value="_inputText"
                      Immediate="true"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Placeholder="@WhisperPlaceholder"
                      Disabled="@(!GameState.IsConnected || GameState.CurrentCharacterId is null)"
                      Class="flex-grow-1" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SendMessage"
                   Disabled="@(string.IsNullOrWhiteSpace(_inputText) || !GameState.IsConnected || GameState.CurrentCharacterId is null)">
            @(IsWhisperActive ? "Whisper" : "Send")
        </MudButton>
    </div>
</TextPanel>
