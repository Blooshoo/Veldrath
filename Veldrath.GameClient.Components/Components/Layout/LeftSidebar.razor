@using Veldrath.GameClient.Core.Abstractions
@using Microsoft.Extensions.Logging
@using MudBlazor
@using Veldrath.GameClient.Components.Models
@inject NavigationManager Navigation
@inject ILogger<RightSidebar> Logger
@inject IGameApiClient Api

@* ── LEFT SIDEBAR: navigation, nearby entities, discovery, and actions ── *@
<MudStack Spacing="2" Class="game-sidebar game-sidebar-left">
    <TextPanel Title="Navigation" Icon="@Icons.Material.Filled.Explore">
        <MudNavLink Icon="@Icons.Material.Filled.Person"
                    OnClick="() => OnOpenOverlay.InvokeAsync(GameOverlay.OverlayKind.CharacterSheet)">
            Character
        </MudNavLink>
        <MudNavLink Icon="@Icons.Material.Filled.Inventory"
                    OnClick="() => OnOpenOverlay.InvokeAsync(GameOverlay.OverlayKind.Inventory)">
            Inventory
        </MudNavLink>
        @* The text map is rendered inline on /Game/Play; there is no separate /Game/Map route. *@
        <MudNavLink Icon="@Icons.Material.Filled.CollectionsBookmark"
                    OnClick="() => OnOpenOverlay.InvokeAsync(GameOverlay.OverlayKind.Journal)">
            Journal
        </MudNavLink>
    </TextPanel>

    <EntityList Title="Nearby Players"
                Icon="@Icons.Material.Filled.Group"
                Items="@OccupantItems"
                EmptyText="No other players nearby." />

    <EntityList Title="Nearby Enemies"
                Icon="@Icons.Material.Filled.BugReport"
                Items="@EnemyItems"
                EmptyText="No enemies nearby." />

    @if (GameState.KnownLocations.Count > 0)
    {
        <EntityList Title="Known Locations"
                    Icon="@Icons.Material.Filled.Place"
                    Items="@KnownLocationItems"
                    OnSelect="OnLocationSelected"
                    EmptyText="No known locations." />
    }

    @if (GameState.CurrentLocationConnections.Count > 0)
    {
        <EntityList Title="Connections"
                    Icon="@Icons.Material.Filled.AltRoute"
                    Items="@ConnectionItems"
                    OnSelect="OnLocationSelected"
                    EmptyText="No connections from here." />
    }

    <TextPanel Title="Actions" Icon="@Icons.Material.Filled.Bolt">
        <MudStack Spacing="2">
            @if (GameState.CurrentZone.HasMerchant)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="VisitShopAsync"
                           Disabled="@(!Hub.IsConnected || GameState.CurrentCharacterId is null)" Class="sidebar-btn">
                    Visit Shop
                </MudButton>
            }

            @if (GameState.CurrentZone.HasInn)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="RestAtLocationAsync"
                           Disabled="@(!Hub.IsConnected || GameState.CurrentCharacterId is null)" Class="sidebar-btn">
                    Rest
                </MudButton>
            }

            @if (GameState.CurrentCharacter.UnspentAttributePoints > 0)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Tertiary" FullWidth="true" OnClick="AllocateStrengthAsync"
                           Disabled="@(!Hub.IsConnected || GameState.CurrentCharacterId is null)" Class="sidebar-btn"
                           title="@($"Unspent: {GameState.CurrentCharacter.UnspentAttributePoints}")">
                    Allocate Attribute Point
                </MudButton>
            }

            <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="SearchAreaAsync"
                       Disabled="@(!Hub.IsConnected || GameState.CurrentCharacterId is null)" Class="sidebar-btn"
                       StartIcon="@Icons.Material.Filled.Search">
                Search Area
            </MudButton>

            <MudButton Variant="Variant.Outlined" FullWidth="true" OnClick="LeaveZoneAsync"
                       Disabled="@(!Hub.IsConnected || GameState.CurrentCharacterId is null)" Class="sidebar-btn"
                       StartIcon="@Icons.Material.Filled.Logout">
                Leave Zone
            </MudButton>
        </MudStack>
    </TextPanel>
</MudStack>
