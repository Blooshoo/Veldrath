# @veldrath/web — SvelteKit app with Better Auth.
#
# DATABASE_URL is used by the SvelteKit server for Better Auth tables only.
# Use a dedicated Postgres role whose search_path points at the auth schema
# (for example: ALTER ROLE veldrath_auth SET search_path = auth, public).
DATABASE_URL="postgres://localhost:5432/veldrath"

# Public origin of the SvelteKit app. adapter-node requires ORIGIN at runtime.
ORIGIN="http://localhost:5173"

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# Game JWT — MUST match Veldrath.Server Jwt:Key / Jwt:Issuer / Jwt:Audience.
# SvelteKit mints short-lived game tokens with this key.
JWT_KEY=""
JWT_ISSUER="Veldrath"
JWT_AUDIENCE="Veldrath"

# Public endpoints used by the browser.
PUBLIC_API_URL="http://localhost:9000"
PUBLIC_HUB_URL="http://localhost:9000/hubs/game"

# OAuth providers — leave blank to disable a provider.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
