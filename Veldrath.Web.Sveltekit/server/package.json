{
  "name": "@your-scope/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Colyseus server hosting authoritative WebSocket sessions with PostgreSQL persistence.",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "db:migrate": "node ../migrate.mjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.17.46",
    "@colyseus/schema": "^4.0.30",
    "@colyseus/ws-transport": "^0.17.13",
    "@your-scope/engine": "*",
    "@your-scope/shared": "*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.17.26",
    "@types/pg": "^8.20.3",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.5"
  }
}
