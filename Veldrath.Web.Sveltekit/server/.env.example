# @your-scope/server — Node WebSocket server (Colyseus + PostgreSQL persistence).
# Loaded via dotenv in server/src/index.ts (`npm run dev` / `npm start`).
# Copy this file to server/.env and adjust. Existing env vars always win.

# HTTP/WebSocket listen config
PORT=3000
# HOST=0.0.0.0

# App database (PostgreSQL) — must match client/.env's DATABASE_URL (same
# database; auth tables are touched only by the SvelteKit client).
DATABASE_URL="postgres://localhost:5432/yourproject"

# WS ticket HMAC secret — SHARED with the SvelteKit client (same value in
# client/.env). For production use 32 characters and generated with high
# entropy.
WS_AUTH_SECRET=""
